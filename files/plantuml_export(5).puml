@startuml
title Самовывоз

actor Покупатель as B
participant "Приложение" as A
participant "Сервер" as S
participant "Склад" as W
participant "Терминал ПВЗ" as T

B -> A : Выбрал самовывоз
A -> S : Бронь
S -> W : Резерв товара
W --> S : Ок
S --> B : Бронь на время

B -> A : Оплата
A -> S : Оплачено
S --> B : Код получения

B -> T : Код
T -> S : Проверить

alt Резерв активен
  S --> T : Ок
  T -> W : Списать
  T --> B : Товар выдан
else Резерв истёк
  S --> T : Истёк
  S -> W : Вернуть в продажу
  T --> B : Резерв истёк
end

@enduml