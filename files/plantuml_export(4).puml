@startuml
title Возврат товара

actor Покупатель as B
participant "Кабинет" as C
participant "Возвраты" as R
participant "Сотрудник ПВЗ" as S
participant "Контроль качества" as Q

B -> C : Заявка на возврат
C -> R : Создать заявку
R --> B : QR-код

B -> S : Товар + QR-код
S -> R : Сканирует код
R --> S : Приём подтверждён
R -> Q : Товар на проверку

alt Без повреждений
  Q -> R : Проверка пройдена
  R --> B : Деньги возвращены
else Есть повреждения
  Q -> R : Повреждения
  R --> B : Возврат отклонён
end

@enduml